<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Alaz</vendor>
  <action id="org.alaz.gfx.set-boot-mode">
    <description>Change the GPU boot mode (applied at next reboot; leaving Eco also re-enables the dGPU now)</description>
    <description xml:lang="tr">GPU açılış modunu değiştir (yeniden başlatmada uygulanır; Eco'dan çıkış dGPU'yu hemen yeniden etkinleştirir)</description>
    <message>Authentication is required to change the GPU mode (this may stop supergfxd and re-enable the dGPU)</message>
    <message xml:lang="tr">GPU modunu değiştirmek için kimlik doğrulaması gerekir (supergfxd durdurulabilir, dGPU yeniden etkinleştirilebilir)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/alaz-gfx-helper</annotate>
    <!-- pkexec takes the FIRST action whose exec.path matches and whose exec.argv1 (if any) matches;
         without argv1 this action matched live-eco/live-hybrid too and asked for a password. -->
    <annotate key="org.freedesktop.policykit.exec.argv1">set-boot-mode</annotate>
  </action>
  <action id="org.alaz.gfx.live-eco">
    <description>Switch the GPU to Eco now (the dGPU is powered off)</description>
    <description xml:lang="tr">GPU'yu şimdi Eco moduna al (dGPU kapatılır)</description>
    <message>Authentication is required to switch the GPU to Eco now</message>
    <message xml:lang="tr">GPU'yu Eco moduna almak için kimlik doğrulaması gerekir</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/alaz-gfx-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">live-eco</annotate>
  </action>
  <action id="org.alaz.gfx.live-hybrid">
    <description>Switch the GPU to Hybrid now (the dGPU is powered on)</description>
    <description xml:lang="tr">GPU'yu şimdi Hybrid moduna al (dGPU açılır)</description>
    <message>Authentication is required to switch the GPU to Hybrid now</message>
    <message xml:lang="tr">GPU'yu Hybrid moduna almak için kimlik doğrulaması gerekir</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/alaz-gfx-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">live-hybrid</annotate>
  </action>
</policyconfig>
