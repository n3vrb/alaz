# Alaz: give the logged-in user (uaccess) access to the vendor CONTROL interface of ASUS ROG peripherals only.
# Input interfaces (keys, pointer) stay root-only. Must sort before 73-seat-late.rules for uaccess to apply.
# All ATTRS{} keys of one rule must match the SAME parent device, and idVendor/idProduct (usb_device) and
# bInterfaceNumber (usb_interface) live on different parents, so the device is tagged first and the interface
# is checked in a second rule.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1ace", ENV{ALAZ_PERIPH}="omni"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1b84|1b82", ENV{ALAZ_PERIPH}="pelta"
# ROG OMNI RECEIVER (Harpe Ace Mini): USB interface 2 (vendor report IDs 1/2/3).
SUBSYSTEM=="hidraw", ENV{ALAZ_PERIPH}=="omni", ATTRS{bInterfaceNumber}=="02", TAG+="uaccess"
# ROG PELTA, 2.4 GHz dongle (1b84) and USB-C cable (1b82): USB interface 3 (vendor report 0xCC).
SUBSYSTEM=="hidraw", ENV{ALAZ_PERIPH}=="pelta", ATTRS{bInterfaceNumber}=="03", TAG+="uaccess"
